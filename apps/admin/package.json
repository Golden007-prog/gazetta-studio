{
  "name": "@gazetta/admin",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx src/server/dev.ts",
    "dev:ui": "vite",
    "dev": "npm run dev:api & npm run dev:ui",
    "build": "vite build",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude tests/docker.test.ts && vitest run tests/docker.test.ts",
    "test:coverage": "vitest run --exclude tests/docker.test.ts --coverage --coverage.provider=v8 --coverage.include='src/**' --coverage.reporter=json-summary --coverage.reporter=text-summary && vitest run tests/docker.test.ts"
  },
  "dependencies": {
    "@formkit/drag-and-drop": "0.6.1",
    "@hono/node-server": "^2.1.5",
    "@primeuix/themes": "^2.0.3",
    "@tanstack/query-async-storage-persister": "^5.105.0",
    "@tanstack/vue-query": "^5.105.0",
    "@vueuse/core": "^15.0.0",
    "gazetta": "*",
    "hono": "^4.13.14",
    "idb": "^8.0.4",
    "morphdom": "^2.7.8",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13"
  }
}
