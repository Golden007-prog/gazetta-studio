node_modules/
dist/
admin-dist/
*.tsbuildinfo
.tmp/
.wrangler/
.seed-output/
.env
.env.*
.claude/settings.local.json
.claude/scheduled_tasks.lock
CLAUDE.local.md
test-results/
.stryker-tmp/
reports/

# Per-item sidecars written by the publish pipeline. Shape: `.<8-hex>.hash`
# and `.pub-*` (see docs/sidecars.md). Transient — regenerated on every
# publish, never authoritative. Anchored under any `targets/` dir so we
# don't accidentally swallow legitimate dotfiles elsewhere.
**/targets/**/.[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].hash
**/targets/**/.[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].hash.*
**/targets/**/.pub-*

# Reverse-dep indices — derived from page/fragment manifests, rebuilt
# on save / publish / reindex CLI. Live under `.gazetta/{asset-refs,
# fragment-deps}/`. Targets carry their own copy; we don't commit the
# source-side editable target's copy either.
**/targets/**/.gazetta/asset-refs/
**/targets/**/.gazetta/fragment-deps/

# Per-target history — runtime state written by save/publish recorders.
# Content-addressed blobs + revision manifests; regenerated and (per
# retention) garbage-collected by the runtime. Same anchoring as the
# reverse-dep indices: only inside a target's `.gazetta/`.
**/targets/**/.gazetta/history/

# Per-target audit log — runtime state written by audit recorders.
# Per-instance JSONL files (events-{instance}.jsonl). Same anchoring as
# history; never committed.
**/targets/**/.gazetta/audit/

# Rendered output from `gazetta publish` to filesystem targets. The
# editable source of truth (page.json, fragment.json, site.config.ts) stays
# tracked; everything below is regenerated on every publish.
#   - {route}/index.html and the route directories created for each page
#     (e.g. blog/, docs/) when the page route is non-root
#   - the site-root index.html (rendered home page)
#   - site.json (publish-time site manifest summary)
#   - index/fragments.json and any other aggregate indices
**/targets/**/index.html
**/targets/**/index.*.html
**/targets/**/site.json
**/targets/**/index/

# Bot transcripts — uploaded as workflow artifact in CI; locally accumulate after
# real bot runs or replays. Don't commit.
bots/transcripts/
bots/test-outputs/
# Per-bot reviewer-log — persisted across runs via GH Actions cache
# (per ADR-0011). Never committed; local files appear when running
# bots locally for testing/development.
bots/*/reviewer-log.jsonl
# cut-planner's raw memory tier (design-cut-planner.md Q7a) — same
# persistence model: GH Actions cache, never committed.
bots/cut-planner/decision-log.jsonl
# mutation-watcher's per-run artifact staging dir — re-fetched every cron from
# the latest Mutation workflow run. Never authoritative.
bots/mutation-report-staging/

# Storybook — local-only artifacts. `storybook-static/` is the build output
# (`npm run build-storybook`); `*storybook.log` covers the debug log Storybook
# init writes on errors.
storybook-static/
*storybook.log

# Playwright MCP server's working dir — page snapshots, console logs, and
# screenshots Claude captures during browser-verification sessions. Always
# transient; never committed.
.playwright-mcp/

# Coverage reports (npm run test:coverage)
coverage/
