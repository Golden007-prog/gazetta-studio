{
  "name": "@gazetta/bots",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Repo-scoped bots that run on GitHub Actions cron schedules, and the roadmap-board sync a session runs. Each lives in its own subdirectory and shares helpers from _lib/.",
  "scripts": {
    "flake-watcher": "tsx flake-watcher/index.ts",
    "mutation-watcher": "tsx mutation-watcher/index.ts",
    "triage-bot": "tsx triage-bot/index.ts",
    "discovery-prep-bot": "tsx discovery-prep-bot/index.ts",
    "fix-bot": "tsx fix-bot/index.ts",
    "fix-bot:compact": "tsx fix-bot/compact.ts",
    "feature-bot": "tsx feature-bot/index.ts",
    "dead-code-watcher": "tsx dead-code-watcher/index.ts",
    "dead-code-watcher:compact": "tsx dead-code-watcher/compact.ts",
    "mutation-area-picker": "tsx mutation-area-picker/index.ts",
    "mutation-area-picker:compact": "tsx mutation-area-picker/compact.ts",
    "review-on-comment": "tsx review-on-comment/index.ts",
    "review-bot": "tsx review-bot/index.ts",
    "review-bot:compact": "tsx review-bot/compact.ts",
    "roadmap-board": "tsx roadmap-board/index.ts",
    "replay": "tsx _lib/replay.ts",
    "test": "vitest run",
    "cut-planner": "tsx cut-planner/index.ts",
    "cut-planner:compact": "tsx cut-planner/compact.ts"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
